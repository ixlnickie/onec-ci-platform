# Скопируйте в provision/.env и заполните. Файл .env в git не коммитится.

# --- GitLab ---
GITLAB_URL=http://185.20.225.253:8929
# Personal access token администратора, scope api
GITLAB_TOKEN=replace-with-admin-pat
CI_GROUP=onec-platform
CI_TEMPLATES_PROJECT=ci-templates
TEMPLATE_GROUP=onec-templates
TEMPLATE_PROJECT=edt-configuration

# --- SonarQube ---
# Внешний адрес (для генерации токена скриптом)
SONAR_URL=http://185.20.225.253:9000
# Внутренний адрес для раннера (сеть docker compose)
SONAR_CI_URL=http://sonarqube:9000
SONAR_ADMIN_USER=admin
SONAR_ADMIN_PASSWORD=replace-me
# Если токен уже есть — можно указать его и не задавать пароль
SONAR_TOKEN=

# --- System hook / сервис автодонастройки ---
HOOK_URL=http://hook-service:8099/hooks/gitlab
HOOK_SECRET=replace-me

# --- 1С ---
# true — когда на раннере `onec` появится платформа 1С
ONEC_ENABLED=false
ONEC_CONFIG_PATH=src
