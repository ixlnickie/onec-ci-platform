# Скопируйте в docker/.env и заполните. Файл .env в git не коммитится.
# Адрес и порты GitLab (доступ по IP)
GITLAB_EXTERNAL_HOST=185.20.225.253
GITLAB_HTTP_PORT=8929
GITLAB_SSH_PORT=2224
# Пароль root в GitLab при первой инициализации
GITLAB_ROOT_PASSWORD=replace-me

# SonarQube
SONAR_HTTP_PORT=9000
SONAR_DB_NAME=sonar
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=replace-me
SONAR_ADMIN_PASSWORD=replace-me
# Версия плагина BSL для ci/scripts/fetch-bsl-plugin.sh
SONAR_BSL_PLUGIN_VERSION=replace-me
